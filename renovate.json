{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["github-actions", "mise"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 1"],
  "updateNotScheduled": false,
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["zig", "zls"],
      "groupName": "Zig and ZLS",
      "groupSlug": "zig-and-zls"
    }
  ]
}
